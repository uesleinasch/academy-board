{
  "name": "academy-board",
  "version": "0.1.0",
  "description": "Quadro branco offline (Excalidraw) para desenhar diagramas nas aulas ao vivo",
  "author": "Ueslei Nascimento <ueslei.nascimento@jacto.com.br>",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/copiar-fontes-excalidraw.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "pacote": "npm run build && electron-builder --linux dir",
    "dist": "npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-store": "^12.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "desktopName": "academy-board.desktop"
}
